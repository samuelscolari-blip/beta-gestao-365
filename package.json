{
  "name": "beta-gestao-365",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "diagnose:live": "node scripts/live-browser-diagnostic.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/cloudflare-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:css:new": "stylelint \"app/styles/**/*.css\" \"app/**/*.module.css\" --allow-empty-input",
    "audit:css-debt": "node scripts/audit-css-debt.mjs",
    "db:generate": "bash scripts/cloudflare-env.sh -- drizzle-kit generate",
    "db:migrate:remote": "wrangler d1 migrations apply beta-gestao-365-db --remote --config wrangler.jsonc",
    "deploy:cloudflare": "vinext deploy --skip-build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "^9.3.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module",
  "displayName": "Beta Gestão 365"
}
